// 8. HANDLER INTERFACE + RPC CHANNEL
// ────────────────────────────────────────────────────────────
 
public interface IRpcHandler
{
    string ServiceName { get; }
    Task<RpcResponse> HandleAsync(RpcRequest request);
}
 
public sealed class RpcChannel
{
    private readonly LoadBalancer      _lb;
    private readonly RetryPolicy       _retryPolicy;
    private readonly MiddlewarePipeline _pipeline;
    private readonly Dictionary<string, IRpcHandler> _handlers = new();
 
    public RpcChannel(LoadBalancer lb,
                      RetryPolicy? retryPolicy = null,
                      MiddlewarePipeline? pipeline = null)
    {
        _lb          = lb;
        _retryPolicy = retryPolicy ?? new RetryPolicy();
        _pipeline    = pipeline    ?? new MiddlewarePipeline();
    }
 
    public void RegisterHandler(IRpcHandler handler)
        => _handlers[handler.ServiceName] = handler;
 
    /// <summary>
    /// Executa o request através do middleware pipeline + retry.
    /// </summary>
    public Task<RpcResponse> CallAsync(RpcRequest request) =>
        _pipeline.Build(CoreCallAsync)(request);
 
    // Handler interno que contém a lógica de retry + CB
    private async Task<RpcResponse> CoreCallAsync(RpcRequest request)
    {
        for (int attempt = 0; attempt < _retryPolicy.MaxAttempts; attempt++)
        {
            if (attempt > 0)
            {
                var delay = _retryPolicy.ComputeDelay(attempt);
                Console.WriteLine(
                    $"  [Retry] #{request.RequestId} tentativa {attempt + 1}/{_retryPolicy.MaxAttempts} " +
                    $"(delay={delay.TotalMilliseconds:F0}ms)");
                await Task.Delay(delay);
            }
 
            var endpoint = _lb.Pick(request.ServiceName);
            if (endpoint is null)
                return Fail(request, "No healthy endpoints", StatusCode.Unavailable);
 
            // Circuit Breaker: aborta cedo se aberto
            if (!endpoint.CircuitBreaker.AllowRequest())
            {
                Console.WriteLine($"  [CB:{endpoint.Id}] Blocked (Open)");
                continue;   // tenta próximo endpoint no próximo ciclo
            }
 
            try
            {
                Interlocked.Increment(ref endpoint.ActiveConns);
 
                // Simula latência de rede + falhas ocasionais
                await SimulateNetworkAsync(endpoint);
 
                if (!_handlers.TryGetValue(request.ServiceName, out var handler))
                    return Fail(request, "Handler not registered", StatusCode.Internal);
 
                var response = await handler.HandleAsync(
                    request.WithChildSpan());
 
                endpoint.CircuitBreaker.RecordSuccess();
                return response;
            }
            catch (SimulatedNetworkException ex)
            {
                Console.WriteLine($"  [Net] {endpoint.Id} erro: {ex.Message}");
                endpoint.CircuitBreaker.RecordFailure();
 
                if (attempt == _retryPolicy.MaxAttempts - 1)
                    return Fail(request, ex.Message, StatusCode.Unavailable);
            }
            finally
            {
                Interlocked.Decrement(ref endpoint.ActiveConns);
            }
        }
 
        return Fail(request, "Esgotadas as tentativas", StatusCode.Unavailable);
    }
 
    private static RpcResponse Fail(RpcRequest req, string err, StatusCode code) =>
        new(req.RequestId, false, "", err, code);
 
    // Simula latência e erros de rede (5% de chance de falha)
    private static async Task SimulateNetworkAsync(ServiceEndpoint ep)
    {
        await Task.Delay(Random.Shared.Next(5, 80));
        if (Random.Shared.NextDouble() < 0.05)
            throw new SimulatedNetworkException($"Connection reset by {ep.Address}");
    }
}
 
public sealed class SimulatedNetworkException : Exception
{
    public SimulatedNetworkException(string msg) : base(msg) { }
}
 
