public delegate Task<RpcResponse> RpcDelegate(RpcRequest request);
public delegate Task<RpcResponse> RpcMiddleware(RpcRequest request, RpcDelegate next);
 
/// <summary>
/// Pipeline de middlewares inspirado no ASP.NET Core IMiddleware.
/// Cada middleware pode inspecionar/modificar request e response,
/// ou curto-circuitar a chain.
/// </summary>
public sealed class MiddlewarePipeline
{
    private readonly List<RpcMiddleware> _middlewares = new();
    private RpcDelegate? _compiled;
 
    public MiddlewarePipeline Use(RpcMiddleware middleware)
    {
        _middlewares.Add(middleware);
        _compiled = null;   // invalida cache
        return this;
    }
 
    /// <summary>
    /// Constrói a chain de forma similar ao Compose funcional:
    /// M1(M2(M3(handler)))
    /// </summary>
    public RpcDelegate Build(RpcDelegate handler)
    {
        if (_compiled is not null) return _compiled;
 
        RpcDelegate pipeline = handler;
        for (int i = _middlewares.Count - 1; i >= 0; i--)
        {
            var mw   = _middlewares[i];
            var next = pipeline;
            pipeline = req => mw(req, next);
        }
        _compiled = pipeline;
        return pipeline;
    }
}
 
