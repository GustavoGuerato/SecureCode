/// <summary>
/// Coletador de métricas em memória.
/// Num sistema real seria exposto via /metrics para Prometheus.
/// </summary>
public sealed class MetricsCollector
{
    // Contadores por (service, method)
    private readonly ConcurrentDictionary<string, long> _counters  = new();
    // Histograma simples de latência (lista de samples)
    private readonly ConcurrentDictionary<string, ConcurrentBag<long>> _latencies = new();
 
    public void Increment(string service, string method, bool success)
    {
        var key = $"{service}.{method}.{(success ? "ok" : "err")}";
        _counters.AddOrUpdate(key, 1, (_, v) => v + 1);
    }
 
    public void RecordLatency(string service, string method, long ms)
    {
        var key = $"{service}.{method}";
        _latencies.GetOrAdd(key, _ => new ConcurrentBag<long>()).Add(ms);
    }
 
    public void PrintReport()
    {
        Console.WriteLine("\n╔══════════════════ MÉTRICAS ══════════════════╗");
 
        Console.WriteLine("  Counters:");
        foreach (var (k, v) in _counters.OrderBy(x => x.Key))
            Console.WriteLine($"    {k,-45} {v,6}");
 
        Console.WriteLine("  Latências (p50 / p95 / p99) [ms]:");
        foreach (var (k, bag) in _latencies.OrderBy(x => x.Key))
        {
            var sorted = bag.OrderBy(x => x).ToArray();
            if (sorted.Length == 0) continue;
            Console.WriteLine($"    {k,-35}  p50={Percentile(sorted, 50),4}  p95={Percentile(sorted, 95),4}  p99={Percentile(sorted, 99),4}");
        }
 
        Console.WriteLine("╚═══════════════════════════════════════════════╝\n");
    }
 
    private static long Percentile(long[] sorted, int p)
    {
        var idx = (int)Math.Ceiling(p / 100.0 * sorted.Length) - 1;
        return sorted[Math.Clamp(idx, 0, sorted.Length - 1)];
    }
}
 
