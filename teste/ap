public static class Program
{
    public static async Task Main()
    {
        Console.WriteLine("╔══════════════════════════════════════════╗");
        Console.WriteLine("║   Distributed Services Core  (v2)        ║");
        Console.WriteLine("╚══════════════════════════════════════════╝\n");
 
        var metrics = new MetricsCollector();
 
        await using var registry = new ServiceRegistry(TimeSpan.FromSeconds(4));
 
        registry.Register(new ServiceEndpoint("user-01", "UserService",    "10.0.0.1:9000", failureThreshold: 2));
        registry.Register(new ServiceEndpoint("user-02", "UserService",    "10.0.0.2:9000", failureThreshold: 2));
        registry.Register(new ServiceEndpoint("user-03", "UserService",    "10.0.0.3:9000", failureThreshold: 2));
        registry.Register(new ServiceEndpoint("prod-01", "ProductService", "10.0.0.4:9001", failureThreshold: 2));
        registry.Register(new ServiceEndpoint("prod-02", "ProductService", "10.0.0.5:9001", failureThreshold: 2));
 
        // ── Load Balancer — Power of Two Choices ──────────────
        var lb = new LoadBalancer(registry, LbStrategy.PowerOfTwo);
 
        // ── Middleware Pipeline ───────────────────────────────
        var timeout = new TimeoutMiddleware(TimeSpan.FromMilliseconds(300));
        var mwMetrics = new MetricsMiddleware(metrics);
 
        var pipeline = new MiddlewarePipeline()
            .Use(ValidationMiddleware.InvokeAsync)
            .Use(LoggingMiddleware.InvokeAsync)
            .Use(mwMetrics.InvokeAsync)
            .Use(timeout.InvokeAsync);
 
        // ── Canal RPC ─────────────────────────────────────────
        var retryPolicy = new RetryPolicy
        {
            MaxAttempts = 3,
            BaseDelay   = TimeSpan.FromMilliseconds(50),
            MaxDelay    = TimeSpan.FromMilliseconds(500),
        };
 
        var channel = new RpcChannel(lb, retryPolicy, pipeline);
        channel.RegisterHandler(new UserService());
        channel.RegisterHandler(new ProductService());
 
        // ════════════════════════════════════════════════════════
        // Batch 1 — Chamadas concorrentes normais
        // ════════════════════════════════════════════════════════
        Console.WriteLine("\n─── Batch 1: chamadas concorrentes ─────────────\n");
 
        var batch1 = await Task.WhenAll(
            channel.CallAsync(new RpcRequest("UserService",    "GetUser",    "1")),
            channel.CallAsync(new RpcRequest("UserService",    "GetUser",    "2")),
            channel.CallAsync(new RpcRequest("UserService",    "ListUsers",  "")),
            channel.CallAsync(new RpcRequest("UserService",    "GetUser",    "99")),   // NotFound
            channel.CallAsync(new RpcRequest("ProductService", "GetProduct", "42")),
            channel.CallAsync(new RpcRequest("ProductService", "GetProduct", "7")),
            channel.CallAsync(new RpcRequest("ProductService", "DeleteAll",  "")),     // método inválido
            channel.CallAsync(new RpcRequest("",               "Whatever",   ""))      // inválido → ValidationMW
        );
 
        PrintResults("Batch 1", batch1);
 
        // ════════════════════════════════════════════════════════
        // Batch 2 — Mutations
        // ════════════════════════════════════════════════════════
        Console.WriteLine("\n─── Batch 2: mutations ──────────────────────────\n");
 
        var batch2 = await Task.WhenAll(
            channel.CallAsync(new RpcRequest("UserService",
                "CreateUser", """{"id":"4","name":"Clara","role":"pm"}""")),
 
            channel.CallAsync(new RpcRequest("ProductService",
                "UpdatePrice", """{"id":"42","price":14.99}""")),
 
            channel.CallAsync(new RpcRequest("ProductService",
                "GetProduct", "42"))   // deve refletir o novo preço
        );
 
        PrintResults("Batch 2", batch2);
 
        // ════════════════════════════════════════════════════════
        // Batch 3 — Stress: 20 chamadas paralelas
        // ════════════════════════════════════════════════════════
        Console.WriteLine("\n─── Batch 3: stress (20 chamadas) ──────────────\n");
 
        var stress = Enumerable.Range(1, 20).Select(i =>
            channel.CallAsync(new RpcRequest("UserService", "GetUser",
                (i % 4 + 1).ToString())));
 
        var stressResults = await Task.WhenAll(stress);
        var ok  = stressResults.Count(r => r.Success);
        var err = stressResults.Length - ok;
        Console.WriteLine($"  Stress result: {ok} OK / {err} ERR de {stressResults.Length} chamadas");
 
        // ════════════════════════════════════════════════════════
        // Estado dos endpoints após tudo
        // ════════════════════════════════════════════════════════
        Console.WriteLine("\n─── Estado final dos endpoints ─────────────────\n");
        foreach (var ep in registry.All("UserService"))
            Console.WriteLine($"  UserService    {ep}");
        foreach (var ep in registry.All("ProductService"))
            Console.WriteLine($"  ProductService {ep}");
 
        // ════════════════════════════════════════════════════════
        // Relatório de métricas
        // ════════════════════════════════════════════════════════
        metrics.PrintReport();
 
        Console.WriteLine("=== Done ===");
    }
 
    private static void PrintResults(string label, RpcResponse[] results)
    {
        Console.WriteLine($"\n  Resultados [{label}]:");
        foreach (var r in results)
        {
            var icon = r.Success ? "✓" : "✗";
            var body = r.Success ? Truncate(r.Payload, 60) : r.Error;
            Console.WriteLine($"    {icon} [{r.RequestId}] [{r.Status}] {body}  ({r.LatencyMs}ms)");
        }
    }
 
    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "…";
}