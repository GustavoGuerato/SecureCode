// 7. POLÍTICA DE RETRY — Backoff Exponencial + Jitter
// ────────────────────────────────────────────────────────────
 
/// <summary>
/// Configura a estratégia de retry para o RpcChannel.
/// Usa full-jitter: delay = Random(0, base * 2^attempt)
/// para evitar thundering herd.
/// </summary>
public sealed class RetryPolicy
{
    public int      MaxAttempts    { get; init; } = 3;
    public TimeSpan BaseDelay      { get; init; } = TimeSpan.FromMilliseconds(100);
    public TimeSpan MaxDelay       { get; init; } = TimeSpan.FromSeconds(2);
    public double   Multiplier     { get; init; } = 2.0;
 
    /// <summary>
    /// Predicado: dado o código de status, vale a pena tentar de novo?
    /// Não retenta InvalidArgument nem NotFound (erros do cliente).
    /// </summary>
    public static bool ShouldRetry(StatusCode code) =>
        code is StatusCode.Unavailable or StatusCode.Unknown or StatusCode.Internal;
 
    public TimeSpan ComputeDelay(int attempt)
    {
        // Exponential backoff com full-jitter (AWS pattern)
        var cap   = Math.Min(MaxDelay.TotalMilliseconds,
                             BaseDelay.TotalMilliseconds * Math.Pow(Multiplier, attempt));
        var jitter = Random.Shared.NextDouble() * cap;
        return TimeSpan.FromMilliseconds(jitter);
    }
}
 
