// 3. CIRCUIT BREAKER  (estado: Closed → Open → Half-Open)
// ────────────────────────────────────────────────────────────
 
public enum CircuitState { Closed, Open, HalfOpen }
 
/// <summary>
/// Circuit Breaker por endpoint.
/// Abre após N falhas consecutivas; tenta fechar após cooldown.
/// Padrão clássico de Nygard / Martin Fowler.
/// </summary>
public sealed class CircuitBreaker
{
    private readonly int      _failureThreshold;
    private readonly TimeSpan _cooldown;
 
    private int           _consecutiveFailures;
    private CircuitState  _state = CircuitState.Closed;
    private DateTime      _openedAt;
    private readonly object _mu = new();
 
    public string EndpointId { get; }
    public CircuitState State { get { lock (_mu) return _state; } }
 
    public CircuitBreaker(string endpointId, int failureThreshold = 3,
                          TimeSpan? cooldown = null)
    {
        EndpointId        = endpointId;
        _failureThreshold = failureThreshold;
        _cooldown         = cooldown ?? TimeSpan.FromSeconds(5);
    }
 
    /// <returns>true se a chamada pode prosseguir.</returns>
    public bool AllowRequest()
    {
        lock (_mu)
        {
            switch (_state)
            {
                case CircuitState.Closed:
                    return true;
 
                case CircuitState.Open:
                    if (DateTime.UtcNow - _openedAt >= _cooldown)
                    {
                        _state = CircuitState.HalfOpen;
                        Console.WriteLine($"  [CB:{EndpointId}] → HalfOpen (testando...)");
                        return true;  // deixa uma requisição de sonda passar
                    }
                    return false;
 
                case CircuitState.HalfOpen:
                    return true;
 
                default:
                    return false;
            }
        }
    }
 
    public void RecordSuccess()
    {
        lock (_mu)
        {
            _consecutiveFailures = 0;
            if (_state == CircuitState.HalfOpen)
            {
                _state = CircuitState.Closed;
                Console.WriteLine($"  [CB:{EndpointId}] → Closed ✓");
            }
        }
    }
 
    public void RecordFailure()
    {
        lock (_mu)
        {
            _consecutiveFailures++;
            if (_state == CircuitState.HalfOpen || _consecutiveFailures >= _failureThreshold)
            {
                _state    = CircuitState.Open;
                _openedAt = DateTime.UtcNow;
                Console.WriteLine($"  [CB:{EndpointId}] → Open (falhas={_consecutiveFailures})");
            }
        }
    }
}
 
