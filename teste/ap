public sealed class UserService : IRpcHandler
{
    public string ServiceName => "UserService";
 
    private static readonly Dictionary<string, string> _db = new()
    {
        ["1"] = """{"id":"1","name":"Gustavo","role":"dev","team":"platform"}""",
        ["2"] = """{"id":"2","name":"Ana",    "role":"sre","team":"infra"}""",
        ["3"] = """{"id":"3","name":"Leo",    "role":"dev","team":"mobile"}""",
    };
 
    public Task<RpcResponse> HandleAsync(RpcRequest req) =>
        Task.FromResult(req.Method switch
        {
            "GetUser" => _db.TryGetValue(req.Payload, out var u)
                ? Ok(req, u)
                : Err(req, "User not found", StatusCode.NotFound),
 
            "ListUsers" => Ok(req, $"[{string.Join(",", _db.Values)}]"),
 
            "CreateUser" => HandleCreate(req),
 
            _ => Err(req, $"Unknown method: {req.Method}", StatusCode.InvalidArgument)
        });
 
    private static RpcResponse HandleCreate(RpcRequest req)
    {
        try
        {
            var doc  = JsonDocument.Parse(req.Payload);
            var id   = doc.RootElement.GetProperty("id").GetString() ?? "";
            _db[id]  = req.Payload;
            return Ok(req, req.Payload);
        }
        catch
        {
            return Err(req, "Invalid payload JSON", StatusCode.InvalidArgument);
        }
    }
 
    private static RpcResponse Ok (RpcRequest req, string payload) =>
        new(req.RequestId, true,  payload, Status: StatusCode.Ok);
    private static RpcResponse Err(RpcRequest req, string error, StatusCode code) =>
        new(req.RequestId, false, "", error, code);
}
 
public sealed class ProductService : IRpcHandler
{
    public string ServiceName => "ProductService";
 
    private readonly ConcurrentDictionary<string, decimal> _prices = new()
    {
        ["42"] = 9.99m,
        ["7"]  = 49.90m,
        ["99"] = 199.00m,
    };
 
    public Task<RpcResponse> HandleAsync(RpcRequest req) =>
        Task.FromResult(req.Method switch
        {
            "GetProduct" => _prices.TryGetValue(req.Payload, out var price)
                ? new(req.RequestId, true,
                    $"""{{ "id":"{req.Payload}", "name":"Widget #{req.Payload}", "price":{price:F2} }}""",
                    Status: StatusCode.Ok)
                : new(req.RequestId, false, "", "Product not found", StatusCode.NotFound),
 
            "UpdatePrice" => HandleUpdatePrice(req),
 
            _ => new(req.RequestId, false, "",
                     $"Unknown method: {req.Method}", StatusCode.InvalidArgument)
        });
 
    private RpcResponse HandleUpdatePrice(RpcRequest req)
    {
        try
        {
            var doc   = JsonDocument.Parse(req.Payload);
            var id    = doc.RootElement.GetProperty("id").GetString() ?? "";
            var price = doc.RootElement.GetProperty("price").GetDecimal();
            _prices[id] = price;
            return new(req.RequestId, true,
                       $"""{{ "id":"{id}", "price":{price:F2} }}""",
                       Status: StatusCode.Ok);
        }
        catch
        {
            return new(req.RequestId, false, "",
                       "Invalid payload", StatusCode.InvalidArgument);
        }
    }
}
 
