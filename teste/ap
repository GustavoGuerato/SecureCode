/// <summary>
/// Envelope genérico de request RPC.
/// Equivale ao proto.Message do gRPC.
/// </summary>
public sealed record RpcRequest(
    string ServiceName,   // "UserService"
    string Method,        // "GetUser"
    string Payload,       // JSON / bytes simulados
    string RequestId = ""
)
{
    public string RequestId { get; init; } = RequestId == "" ? Guid.NewGuid().ToString("N")[..8] : RequestId;
}

/// <summary>
/// Envelope genérico de response RPC.
/// </summary>
public sealed record RpcResponse(
    string RequestId,
    bool   Success,
    string Payload,
    string Error = ""
);

// ────────────────────────────────────────────────────────────
// 2. SERVICE REGISTRY  (equivalente ao Consul / Zookeeper)
// ────────────────────────────────────────────────────────────

public sealed class ServiceEndpoint
{
    public string Id          { get; }        // "user-svc-01"
    public string ServiceName { get; }        // "UserService"
    public string Address     { get; }        // "10.0.0.1:8080" (simulado)
    public bool   IsHealthy   { get; set; } = true;
    public int    ActiveConns { get; set; } = 0;  // para least-connections

    public ServiceEndpoint(string id, string serviceName, string address)
    {
        Id          = id;
        ServiceName = serviceName;
        Address     = address;
    }

    public override string ToString() => $"[{Id}@{Address} healthy={IsHealthy} conns={ActiveConns}]";
}

/// <summary>
/// Service Registry em memória.
/// Mantém o mapa de nome → lista de instâncias.
/// </summary>
public sealed class ServiceRegistry
{
    private readonly ConcurrentDictionary<string, List<ServiceEndpoint>> _services = new();
    private readonly ReaderWriterLockSlim _lock = new();

    // Registra uma nova instância (equivale ao gRPC NameResolver / Consul Register)
    public void Register(ServiceEndpoint endpoint)
    {
        _lock.EnterWriteLock();
        try
        {
            if (!_services.TryGetValue(endpoint.ServiceName, out var list))
            {
                list = new List<ServiceEndpoint>();
                _services[endpoint.ServiceName] = list;
            }
            list.Add(endpoint);
            Console.WriteLine($"[Registry] Registered {endpoint}");
        }
        finally { _lock.ExitWriteLock(); }
    }

    // Remove instância (graceful shutdown / deregistro)
    public void Deregister(string serviceId)
    {
        _lock.EnterWriteLock();
        try
        {
            foreach (var list in _services.Values)
                list.RemoveAll(e => e.Id == serviceId);
            Console.WriteLine($"[Registry] Deregistered {serviceId}");
        }
        finally { _lock.ExitWriteLock(); }
    }

    // Retorna snapshot das instâncias saudáveis para um serviço
    public IReadOnlyList<ServiceEndpoint> Resolve(string serviceName)
    {
        _lock.EnterReadLock();
        try
        {
            if (!_services.TryGetValue(serviceName, out var list))
                return Array.Empty<ServiceEndpoint>();

            return list.Where(e => e.IsHealthy).ToList();
        }
        finally { _lock.ExitReadLock(); }
    }

    // Simula um health-check periódico (toggle aleatório para demo)
    public void SimulateHealthCheck()
    {
        var rng = new Random();
        _lock.EnterWriteLock();
        try
        {
            foreach (var list in _services.Values)
                foreach (var ep in list)
                    ep.IsHealthy = rng.NextDouble() > 0.15; // 85% up
        }
        finally { _lock.ExitWriteLock(); }
    }
}

// ────────────────────────────────────────────────────────────
// 3. LOAD BALANCER  (Round-Robin + Least-Connections + Random)
// ────────────────────────────────────────────────────────────

public enum LbStrategy { RoundRobin, LeastConnections, Random }

public sealed class LoadBalancer
{
    private readonly ServiceRegistry _registry;
    private readonly LbStrategy      _strategy;
    private readonly ConcurrentDictionary<string, int> _rrCounters = new();
    private readonly Random _rng = new();

    public LoadBalancer(ServiceRegistry registry, LbStrategy strategy = LbStrategy.RoundRobin)
    {
        _registry = registry;
        _strategy = strategy;
    }

    /// <summary>
    /// Escolhe um endpoint para o serviço informado.
    /// Retorna null se não há instâncias saudáveis.
    /// </summary>
    public ServiceEndpoint? Pick(string serviceName)
    {
        var candidates = _registry.Resolve(serviceName);
        if (candidates.Count == 0) return null;

        return _strategy switch
        {
            LbStrategy.RoundRobin       => PickRoundRobin(serviceName, candidates),
            LbStrategy.LeastConnections => PickLeastConn(candidates),
            LbStrategy.Random           => candidates[_rng.Next(candidates.Count)],
            _                           => candidates[0]
        };
    }

    private ServiceEndpoint PickRoundRobin(string svc, IReadOnlyList<ServiceEndpoint> list)
    {
        var idx = _rrCounters.AddOrUpdate(svc, 0, (_, old) => (old + 1) % list.Count);
        return list[idx];
    }

    private ServiceEndpoint PickLeastConn(IReadOnlyList<ServiceEndpoint> list)
        => list.MinBy(e => e.ActiveConns)!;
}

// ────────────────────────────────────────────────────────────
// 4. RPC CHANNEL  (stub local que simula serialização + envio)
// ────────────────────────────────────────────────────────────

/// <summary>
/// Interface que todo serviço concreto deve implementar.
/// Equivale ao ServiceImpl no lado servidor do gRPC.
/// </summary>
public interface IRpcHandler
{
    string ServiceName { get; }
    Task<RpcResponse> HandleAsync(RpcRequest request);
}

/// <summary>
/// Canal RPC em memória.
/// Numa implementação real: abre socket TCP, serializa proto, etc.
/// Aqui despacha direto para o handler registrado.
/// </summary>
public sealed class RpcChannel
{
    private readonly LoadBalancer _lb;
    // Handlers registrados localmente (simula processos remotos)
    private readonly Dictionary<string, IRpcHandler> _localHandlers = new();

    public RpcChannel(LoadBalancer lb) => _lb = lb;

    public void RegisterHandler(IRpcHandler handler)
        => _localHandlers[handler.ServiceName] = handler;

    /// <summary>
    /// Envia request RPC com retry simples (até 3 tentativas).
    /// </summary>
    public async Task<RpcResponse> CallAsync(RpcRequest request, int maxRetries = 3)
    {
        for (int attempt = 1; attempt <= maxRetries; attempt++)
        {
            var endpoint = _lb.Pick(request.ServiceName);
            if (endpoint is null)
                return new RpcResponse(request.RequestId, false, "", "No healthy endpoints");

            try
            {
                endpoint.ActiveConns++;
                Console.WriteLine($"[RPC] #{request.RequestId} → {request.ServiceName}.{request.Method} via {endpoint.Id} (attempt {attempt})");

                // Simula latência de rede
                await Task.Delay(Random.Shared.Next(10, 60));

                if (!_localHandlers.TryGetValue(request.ServiceName, out var handler))
                    return new RpcResponse(request.RequestId, false, "", "Handler not found");

                var response = await handler.HandleAsync(request);
                Console.WriteLine($"[RPC] #{request.RequestId} ← {(response.Success ? "OK" : "ERR: " + response.Error)}");
                return response;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[RPC] #{request.RequestId} attempt {attempt} failed: {ex.Message}");
                endpoint.IsHealthy = false; // marca endpoint como doente
            }
            finally
            {
                endpoint.ActiveConns = Math.Max(0, endpoint.ActiveConns - 1);
            }
        }

        return new RpcResponse(request.RequestId, false, "", "All retries exhausted");
    }
}

