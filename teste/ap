/// <summary>Serviço fictício de usuários.</summary>
public sealed class UserService : IRpcHandler
{
    public string ServiceName => "UserService";

    private static readonly Dictionary<string, string> _db = new()
    {
        ["1"] = """{"id":"1","name":"Gustavo","role":"dev"}""",
        ["2"] = """{"id":"2","name":"Ana","role":"sre"}""",
    };

    public Task<RpcResponse> HandleAsync(RpcRequest req)
    {
        var result = req.Method switch
        {
            "GetUser" => _db.TryGetValue(req.Payload, out var user)
                            ? new RpcResponse(req.RequestId, true, user)
                            : new RpcResponse(req.RequestId, false, "", "User not found"),

            "ListUsers" => new RpcResponse(req.RequestId, true,
                               $"[{string.Join(",", _db.Values)}]"),

            _ => new RpcResponse(req.RequestId, false, "", $"Unknown method: {req.Method}")
        };

        return Task.FromResult(result);
    }
}

/// <summary>Serviço fictício de produtos.</summary>
public sealed class ProductService : IRpcHandler
{
    public string ServiceName => "ProductService";

    public Task<RpcResponse> HandleAsync(RpcRequest req)
    {
        var payload = req.Method switch
        {
            "GetProduct" => $"""{{ "id":"{req.Payload}", "name":"Widget #{req.Payload}", "price":9.99 }}""",
            _            => null
        };

        var response = payload is not null
            ? new RpcResponse(req.RequestId, true, payload)
            : new RpcResponse(req.RequestId, false, "", $"Unknown method: {req.Method}");

        return Task.FromResult(response);
    }
}

// ────────────────────────────────────────────────────────────
// 6. BOOTSTRAP / DEMO
// ────────────────────────────────────────────────────────────

public static class Program
{
    public static async Task Main()
    {
        Console.WriteLine("=== Distributed Services Core ===\n");

        // --- Registry ---
        var registry = new ServiceRegistry();

        // Registra 3 instâncias do UserService e 2 do ProductService
        registry.Register(new ServiceEndpoint("user-01", "UserService",    "10.0.0.1:9000"));
        registry.Register(new ServiceEndpoint("user-02", "UserService",    "10.0.0.2:9000"));
        registry.Register(new ServiceEndpoint("user-03", "UserService",    "10.0.0.3:9000"));
        registry.Register(new ServiceEndpoint("prod-01", "ProductService", "10.0.0.4:9001"));
        registry.Register(new ServiceEndpoint("prod-02", "ProductService", "10.0.0.5:9001"));

        // --- Load Balancer ---
        var lb = new LoadBalancer(registry, LbStrategy.RoundRobin);

        // --- Canal RPC ---
        var channel = new RpcChannel(lb);
        channel.RegisterHandler(new UserService());
        channel.RegisterHandler(new ProductService());

        // --- Disparar chamadas concorrentes ---
        Console.WriteLine("\n--- Chamadas RPC concorrentes ---\n");

        var tasks = new List<Task<RpcResponse>>
        {
            channel.CallAsync(new RpcRequest("UserService",    "GetUser",    "1")),
            channel.CallAsync(new RpcRequest("UserService",    "GetUser",    "2")),
            channel.CallAsync(new RpcRequest("UserService",    "ListUsers",  "")),
            channel.CallAsync(new RpcRequest("UserService",    "GetUser",    "99")), // not found
            channel.CallAsync(new RpcRequest("ProductService", "GetProduct", "42")),
            channel.CallAsync(new RpcRequest("ProductService", "GetProduct", "7")),
            channel.CallAsync(new RpcRequest("ProductService", "DeleteAll",  "")),  // unknown method
        };

        var results = await Task.WhenAll(tasks);

        Console.WriteLine("\n--- Resultados ---\n");
        foreach (var r in results)
        {
            var status = r.Success ? "✓" : "✗";
            var body   = r.Success ? r.Payload : r.Error;
            Console.WriteLine($"  {status} [{r.RequestId}] {body}");
        }

        // --- Simula health check e nova rodada ---
        Console.WriteLine("\n--- Health check simulado ---\n");
        registry.SimulateHealthCheck();

        Console.WriteLine("Endpoints após health check:");
        foreach (var ep in registry.Resolve("UserService"))
            Console.WriteLine($"  {ep}");

        // Resolve() com Least-Connections
        var lb2    = new LoadBalancer(registry, LbStrategy.LeastConnections);
        var ch2    = new RpcChannel(lb2);
        ch2.RegisterHandler(new UserService());

        Console.WriteLine("\n--- Least-Connections LB ---\n");
        var lc = await Task.WhenAll(
            ch2.CallAsync(new RpcRequest("UserService", "GetUser", "1")),
            ch2.CallAsync(new RpcRequest("UserService", "GetUser", "2"))
        );
        foreach (var r in lc)
            Console.WriteLine($"  [{r.RequestId}] {(r.Success ? r.Payload : r.Error)}");

        Console.WriteLine("\n=== Done ===");
    }
}