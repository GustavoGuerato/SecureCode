public enum LbStrategy { RoundRobin, LeastConnections, Random, PowerOfTwo }
 
public sealed class LoadBalancer
{
    private readonly ServiceRegistry _registry;
    private readonly LbStrategy      _strategy;
    private readonly ConcurrentDictionary<string, int> _rrCounters = new();
    private readonly Random _rng = new();
 
    public LoadBalancer(ServiceRegistry registry,
                        LbStrategy strategy = LbStrategy.RoundRobin)
    {
        _registry = registry;
        _strategy = strategy;
    }
 
    /// <returns>Endpoint escolhido ou null se indisponível.</returns>
    public ServiceEndpoint? Pick(string serviceName)
    {
        var candidates = _registry.Resolve(serviceName);
        if (candidates.Count == 0) return null;
 
        return _strategy switch
        {
            LbStrategy.RoundRobin       => PickRoundRobin(serviceName, candidates),
            LbStrategy.LeastConnections => PickLeastConn(candidates),
            LbStrategy.Random           => candidates[_rng.Next(candidates.Count)],
            LbStrategy.PowerOfTwo       => PickPowerOfTwo(candidates),  // P2C
            _                           => candidates[0]
        };
    }
 
    private ServiceEndpoint PickRoundRobin(string svc,
                                           IReadOnlyList<ServiceEndpoint> list)
    {
        var idx = _rrCounters.AddOrUpdate(
            svc, 0, (_, old) => (old + 1) % list.Count);
        return list[idx];
    }
 
    private static ServiceEndpoint PickLeastConn(IReadOnlyList<ServiceEndpoint> list)
        => list.MinBy(e => e.ActiveConns)!;
 
    /// <summary>
    /// Power of Two Choices: sorteia 2 candidatos aleatórios
    /// e escolhe o de menor carga. Melhor que LeastConn puro
    /// em clusters grandes (menor contenção).
    /// </summary>
    private ServiceEndpoint PickPowerOfTwo(IReadOnlyList<ServiceEndpoint> list)
    {
        if (list.Count == 1) return list[0];
        int i = _rng.Next(list.Count);
        int j;
        do { j = _rng.Next(list.Count); } while (j == i);
        return list[i].ActiveConns <= list[j].ActiveConns ? list[i] : list[j];
    }
}
 
