public sealed class ServiceEndpoint
{
    public string Id          { get; }
    public string ServiceName { get; }
    public string Address     { get; }
    public bool   IsHealthy   { get; set; } = true;
    public int    ActiveConns { get; set; } = 0;
    public int    Weight      { get; init; } = 1;     // para Weighted Round-Robin futuro
 
    // Circuit Breaker dedicado por endpoint
    public CircuitBreaker CircuitBreaker { get; } = default!;
 
    public ServiceEndpoint(string id, string serviceName, string address,
                           int failureThreshold = 3)
    {
        Id            = id;
        ServiceName   = serviceName;
        Address       = address;
        CircuitBreaker = new CircuitBreaker(id, failureThreshold);
    }
 
    public override string ToString() =>
        $"[{Id}@{Address} healthy={IsHealthy} conns={ActiveConns} cb={CircuitBreaker.State}]";
}
 
public sealed class ServiceRegistry : IAsyncDisposable
{
    private readonly ConcurrentDictionary<string, List<ServiceEndpoint>> _services = new();
    private readonly ReaderWriterLockSlim _lock = new();
 
    // Health-check periódico em background
    private readonly CancellationTokenSource _cts = new();
    private readonly Task _healthLoop;
 
    public ServiceRegistry(TimeSpan? healthCheckInterval = null)
    {
        var interval = healthCheckInterval ?? TimeSpan.FromSeconds(3);
        _healthLoop  = RunHealthCheckLoopAsync(interval, _cts.Token);
    }
 
    public void Register(ServiceEndpoint endpoint)
    {
        _lock.EnterWriteLock();
        try
        {
            if (!_services.TryGetValue(endpoint.ServiceName, out var list))
            {
                list = new List<ServiceEndpoint>();
                _services[endpoint.ServiceName] = list;
            }
            list.Add(endpoint);
            Console.WriteLine($"[Registry] Registered {endpoint}");
        }
        finally { _lock.ExitWriteLock(); }
    }
 
    public void Deregister(string serviceId)
    {
        _lock.EnterWriteLock();
        try
        {
            foreach (var list in _services.Values)
                list.RemoveAll(e => e.Id == serviceId);
            Console.WriteLine($"[Registry] Deregistered {serviceId}");
        }
        finally { _lock.ExitWriteLock(); }
    }
 
    /// <summary>
    /// Retorna endpoints saudáveis E com Circuit Breaker não-Open.
    /// </summary>
    public IReadOnlyList<ServiceEndpoint> Resolve(string serviceName)
    {
        _lock.EnterReadLock();
        try
        {
            if (!_services.TryGetValue(serviceName, out var list))
                return Array.Empty<ServiceEndpoint>();
 
            return list
                .Where(e => e.IsHealthy && e.CircuitBreaker.State != CircuitState.Open)
                .ToList();
        }
        finally { _lock.ExitReadLock(); }
    }
 
    /// <summary>Retorna TODOS os endpoints (para inspeção).</summary>
    public IReadOnlyList<ServiceEndpoint> All(string serviceName)
    {
        _lock.EnterReadLock();
        try
        {
            return _services.TryGetValue(serviceName, out var list)
                ? list.ToList()
                : Array.Empty<ServiceEndpoint>();
        }
        finally { _lock.ExitReadLock(); }
    }
 
    // ── Health-check loop ────────────────────────────────────
    // Numa implementação real faria HTTP GET /health ou TCP ping.
    // Aqui simulamos probabilisticamente.
    private async Task RunHealthCheckLoopAsync(TimeSpan interval, CancellationToken ct)
    {
        var rng = new Random();
        while (!ct.IsCancellationRequested)
        {
            await Task.Delay(interval, ct).ConfigureAwait(false);
 
            _lock.EnterWriteLock();
            try
            {
                foreach (var list in _services.Values)
                    foreach (var ep in list)
                    {
                        var wasHealthy = ep.IsHealthy;
                        ep.IsHealthy = rng.NextDouble() > 0.12; // ~88% up-time
                        if (wasHealthy && !ep.IsHealthy)
                            Console.WriteLine($"  [HealthCheck] {ep.Id} → DOWN");
                        else if (!wasHealthy && ep.IsHealthy)
                            Console.WriteLine($"  [HealthCheck] {ep.Id} → UP");
                    }
            }
            finally { _lock.ExitWriteLock(); }
        }
    }
 
    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        try { await _healthLoop.ConfigureAwait(false); }
        catch (OperationCanceledException) { /* esperado */ }
        _lock.Dispose();
    }
}
 
