/// <summary>
/// Envelope genérico de request RPC.
/// Contém metadados de rastreamento (trace/span IDs) para
/// simular distributed tracing estilo OpenTelemetry.
/// </summary>
public sealed record RpcRequest(
    string ServiceName,
    string Method,
    string Payload,
    string RequestId  = "",
    string TraceId    = "",
    string SpanId     = "",
    IDictionary<string, string>? Metadata = null
)
{
    public string RequestId { get; init; } =
        RequestId == "" ? Guid.NewGuid().ToString("N")[..8] : RequestId;
 
    public string TraceId { get; init; } =
        TraceId == "" ? Guid.NewGuid().ToString("N")[..16] : TraceId;
 
    public string SpanId { get; init; } =
        SpanId == "" ? Guid.NewGuid().ToString("N")[..8] : SpanId;
 
    /// <summary>Cria um child-span para propagação de contexto.</summary>
    public RpcRequest WithChildSpan() =>
        this with { SpanId = Guid.NewGuid().ToString("N")[..8] };
}
 
/// <summary>
/// Envelope genérico de response.
/// Inclui código de status inspirado nos status codes do gRPC.
/// </summary>
public sealed record RpcResponse(
    string     RequestId,
    bool       Success,
    string     Payload,
    string     Error      = "",
    StatusCode Status     = StatusCode.Ok,
    long       LatencyMs  = 0
);
 
public enum StatusCode
{
    Ok              = 0,
    Cancelled       = 1,
    Unknown         = 2,
    InvalidArgument = 3,
    NotFound        = 5,
    Unavailable     = 14,
    Internal        = 13,
}
 
