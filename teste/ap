/// <summary>Loga request/response com trace context.</summary>
public static class LoggingMiddleware
{
    public static async Task<RpcResponse> InvokeAsync(
        RpcRequest req, RpcDelegate next)
    {
        Console.WriteLine(
            $"  → [{req.TraceId}/{req.SpanId}] {req.ServiceName}.{req.Method} " +
            $"payload={Truncate(req.Payload, 32)}");
 
        var sw  = Stopwatch.StartNew();
        var res = await next(req);
        sw.Stop();
 
        Console.WriteLine(
            $"  ← [{req.TraceId}/{req.SpanId}] {(res.Success ? "OK" : "ERR")} " +
            $"{sw.ElapsedMilliseconds}ms");
        return res with { LatencyMs = sw.ElapsedMilliseconds };
    }
 
    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "…";
}
 
/// <summary>
/// Valida o request antes de enviar.
/// Rejeita método vazio ou nome de serviço vazio.
/// </summary>
public static class ValidationMiddleware
{
    public static Task<RpcResponse> InvokeAsync(
        RpcRequest req, RpcDelegate next)
    {
        if (string.IsNullOrWhiteSpace(req.ServiceName) ||
            string.IsNullOrWhiteSpace(req.Method))
        {
            return Task.FromResult(new RpcResponse(
                req.RequestId, false, "",
                "Invalid request: ServiceName and Method are required",
                StatusCode.InvalidArgument));
        }
        return next(req);
    }
}
 
/// <summary>
/// Middleware de timeout por request.
/// Se o handler não responder a tempo, cancela e retorna erro.
/// </summary>
public sealed class TimeoutMiddleware
{
    private readonly TimeSpan _timeout;
    public TimeoutMiddleware(TimeSpan timeout) => _timeout = timeout;
 
    public async Task<RpcResponse> InvokeAsync(RpcRequest req, RpcDelegate next)
    {
        using var cts   = new CancellationTokenSource(_timeout);
        var       inner = next(req);
        var       delay = Task.Delay(_timeout, cts.Token);
 
        var completed = await Task.WhenAny(inner, delay);
        if (completed == delay)
        {
            return new RpcResponse(
                req.RequestId, false, "",
                $"Timeout after {_timeout.TotalMilliseconds}ms",
                StatusCode.Cancelled);
        }
 
        cts.Cancel();        // cancela o delay se inner terminou primeiro
        return await inner;
    }
}
 
/// <summary>Coleta métricas de cada chamada.</summary>
public sealed class MetricsMiddleware
{
    private readonly MetricsCollector _metrics;
    public MetricsMiddleware(MetricsCollector metrics) => _metrics = metrics;
 
    public async Task<RpcResponse> InvokeAsync(RpcRequest req, RpcDelegate next)
    {
        var sw  = Stopwatch.StartNew();
        var res = await next(req);
        sw.Stop();
 
        _metrics.Increment(req.ServiceName, req.Method, res.Success);
        _metrics.RecordLatency(req.ServiceName, req.Method, sw.ElapsedMilliseconds);
        return res;
    }
}
 
